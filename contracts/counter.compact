pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger state tracking counter value
export ledger counter: Uint<64>;

/**
 * Increment circuit
 * Computes counter + amount and updates ledger state
 */
export circuit increment(amount: Uint<64>): [] {
  counter = disclose((counter + amount) as Uint<64>);
}

/**
 * Increment with private witness and boundary assertion
 * Asserts amount is strictly positive and updates counter
 */
export circuit incrementWithAssert(amount: Uint<64>, salt: Bytes<32>): [] {
  assert(amount > 0, "Amount must be greater than zero");
  counter = disclose((counter + amount) as Uint<64>);
}

/**
 * Reset circuit
 * Resets counter to zero
 */
export circuit reset(): [] {
  counter = disclose(0);
}
