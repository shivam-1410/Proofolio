/**
 * ============================================================================
 * ZK Proof-of-Reserves: Confidential Solvency Verifier
 * ============================================================================
 * 
 * PRIVACY MODEL & ARCHITECTURE SPECIFICATION:
 * 
 * 1. PUBLIC LEDGER STATE (On-Chain, Globally Verifiable):
 *    - `solvency_status: Boolean`:
 *      Public flag indicating whether the audited entity passed its solvency
 *      verification check. Anyone can query this value on-chain.
 *    - `last_verified_block: Uint<64>`:
 *      The block index / timestamp at which the solvency verification was
 *      proven and confirmed on-chain.
 *    - `commitment_hash: Bytes<32>`:
 *      Cryptographic commitment hash of the private audit inputs. Proves that
 *      the audit is tied to a specific balance sheet snapshot without
 *      revealing any of the underlying figures.
 * 
 * 2. PRIVATE WITNESSES (Client-Side Only, Never Stored On-Chain):
 *    - `total_reserves: Uint<64>`:
 *      The exact raw reserve assets owned and controlled by the institution.
 *    - `total_liabilities: Uint<64>`:
 *      The exact raw customer deposit obligations and liabilities owed.
 *    - `salt: Bytes<32>`:
 *      Cryptographic blinding salt used to generate the input commitment hash,
 *      preventing dictionary attacks against reserve figures.
 * 
 * 3. PROVEN WITHOUT REVEALING:
 *    - The zero-knowledge circuit enforces that `total_reserves >= total_liabilities`.
 *    - The ZK proof guarantees mathematical solvency with 100% cryptographic certainty.
 *    - Selective disclosure (`disclose()`) guarantees that neither raw reserves
 *      nor liabilities are ever emitted to ledger state, events, or tx payloads.
 * ============================================================================
 */

pragma language_version >= 0.23;

import CompactStandardLibrary;

// Public ledger state
export ledger solvency_status: Boolean;
export ledger last_verified_block: Uint<64>;
export ledger commitment_hash: Bytes<32>;

/**
 * Verifies solvency in zero-knowledge.
 * 
 * The entity proves that total_reserves >= total_liabilities (with an optional
 * safety margin requirement) without disclosing the reserve or liability amounts.
 * 
 * @param total_reserves     Private witness representing total reserve assets
 * @param total_liabilities  Private witness representing total liabilities owed
 * @param salt               Private blinding salt for input commitment
 * @param block_number       Current block number / verification sequence
 */
export circuit verifySolvency(
  total_reserves: Uint<64>,
  total_liabilities: Uint<64>,
  salt: Bytes<32>,
  block_number: Uint<64>
): [] {
  // Enforce solvency constraint: reserves must cover liabilities
  assert(total_reserves >= total_liabilities,
    "Solvency check failed: total_reserves must be greater than or equal to total_liabilities");

  // Compute commitment hash of private inputs (salt ensures zero information leakage)
  const commitment = persistentHash<Bytes<32>>(salt);

  // Selectively disclose ONLY the solvency confirmation, commitment hash, and block height
  solvency_status = disclose(true);
  commitment_hash = disclose(commitment);
  last_verified_block = disclose(block_number);
}
